include /usr/share/doc/newsboat/contrib/colorschemes/gruvbox
auto-reload yes
max-items 50

browser "~/.local/bin/mullvad-browser/Browser/start-mullvad-browser %u"

# unbind keys
unbind-key ENTER
unbind-key j
unbind-key k
unbind-key J
unbind-key K

# bind keys - vim style
bind-key j down
bind-key k up
bind-key l open
bind-key h quit
