[global]
font = Monospace 10
monitor = 1
origin = top-center
frame_width = 2
frame_color = "#fbf1c7"
separator_color = frame
highlight = "#83a598"
background = "#282828"
foreground = "#ebdbb2"
corner_radius = 5
progress_bar_corner_radius = 0
corners = top-left,bottom
progress_bar_corners = top-left,bottom-right
offset = (15, 25)
gap_size = 5
format = "<b>󰁕 %a</b>\n%s\n<i>%b</i>"

[urgency_low]
foreground = "#a9b665"
frame_color = "#a9b665"
default_icon = "~/.config/dunst/icons/bell-badge-low.svg"

[urgency_normal]
foreground = "#83a598"
frame_color = "#83a598"
default_icon = "~/.config/dunst/icons/bell-badge.svg"

[urgency_critical]
foreground = "#fb4934"
frame_color = "#fb4934"
default_icon = "~/.config/dunst/icons/alert-decagram.svg"
